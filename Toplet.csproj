<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<TargetExt>.rhp</TargetExt>
		<NoWarn>NU1701</NoWarn>
		<UseWindowsForms>true</UseWindowsForms>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<PropertyGroup>
		<Version>1.0</Version>
		<Title>Toplet</Title>
		<Company>George Kote</Company>
		<Description>Voxel-based topology optimization plugin for Rhino/Grasshopper, with a C++ solver core.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="RhinoCommon" Version="7.0.20314.3001" Condition="'$(TargetFramework)' == 'net48'" ExcludeAssets="runtime" />
	</ItemGroup>

	<ItemGroup>
		<!-- Referenced by Properties/AssemblyInfo.cs's PlugInDescription(Icon, ...) attribute -->
		<EmbeddedResource Include="EmbeddedResources\plugin-utility.ico" />
	</ItemGroup>

	<Target Name="CopyPdbForMonoDebugging" AfterTargets="AfterBuild">
		<Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFiles="$(TargetDir)$(TargetName).rhp.pdb" Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(TargetFramework)' == 'net48' and Exists('$(TargetDir)$(TargetName).pdb')" />
	</Target>

</Project>